{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrawlBuilderEx",
  "version": "1.0.0",
  "identifier": "com.humboldt123.brawlbuilderex",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BrawlBuilderEx - The Ultimate Brawl ISO Builder",
        "width": 334,
        "height": 542,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../Resources/": "Resources/"
    }
  }
}
