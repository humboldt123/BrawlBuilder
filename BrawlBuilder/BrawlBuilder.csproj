<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BrawlBuilder</RootNamespace>
    <AssemblyName>BrawlBuilder</AssemblyName>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="BrawlBuilder.cs" SubType="Form" />
    <Compile Update="BrawlBuilder.Designer.cs" DependentUpon="BrawlBuilder.cs" />
    <Compile Update="BrawlBuilder.WorkerCode.cs" SubType="Form" />
    <EmbeddedResource Update="BrawlBuilder.resx" DependentUpon="BrawlBuilder.cs" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DependentUpon="Resources.resx" DesignTime="True" />
    <None Update="Properties\Settings.settings" Generator="SettingsSingleFileGenerator" LastGenOutput="Settings.Designer.cs" />
    <Compile Update="Properties\Settings.Designer.cs" AutoGen="True" DependentUpon="Settings.settings" DesignTimeSharedInput="True" />
  </ItemGroup>

  <!-- the original BrawlBuilder copies the solution-level Resources folder (wit, CodePatches.txt, file lists, patch xml) next to the exe -->
  <Target Name="CopySolutionResources" AfterTargets="Build">
    <ItemGroup>
      <SolutionResources Include="$(MSBuildThisFileDirectory)..\Resources\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SolutionResources)" DestinationFiles="@(SolutionResources->'$(TargetDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
